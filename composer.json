{
    "name": "heroeslounge/heroeslounge",
    "description": "Heroes Lounge (heroeslounge.gg) - Winter CMS project",
    "homepage": "https://heroeslounge.gg",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "winter/storm": "~1.2.14",
        "winter/wn-system-module": "~1.2.14",
        "winter/wn-backend-module": "~1.2.14",
        "winter/wn-cms-module": "~1.2.14",
        "laravel/framework": "^9.52",
        "wikimedia/composer-merge-plugin": "~2.1.0",
        "winter/wn-user-plugin": "^2.3",
        "winter/wn-pages-plugin": "^2.2",
        "winter/wn-translate-plugin": "^2.4",
        "winter/wn-location-plugin": "^2.2",
        "winter/wn-builder-plugin": "^2.2",
        "winter/wn-notify-plugin": "^2.1",
        "winter/wn-userplus-plugin": "^2.0",
        "winter/wn-googleanalytics-plugin": "^3.1",
        "cweagans/composer-patches": "^1.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5.8",
        "mockery/mockery": "^1.4.4",
        "fakerphp/faker": "^1.9.2",
        "squizlabs/php_codesniffer": "^3.2",
        "php-parallel-lint/php-parallel-lint": "^1.0",
        "dms/phpunit-arraysubset-asserts": "^0.1.0|^0.2.1"
    },
    "scripts": {
        "storage-dirs": [
            "@php -r \"foreach (['app/media', 'app/resized', 'app/uploads/public', 'cms/cache', 'cms/combiner', 'cms/twig', 'framework/cache', 'framework/sessions', 'framework/views', 'logs', 'temp/public'] as \\$d) { is_dir(\\\"storage/\\$d\\\") || mkdir(\\\"storage/\\$d\\\", 0755, true); }\""
        ],
        "post-install-cmd": [
            "@storage-dirs"
        ],
        "post-update-cmd": [
            "@storage-dirs",
            "@php artisan winter:version",
            "@php artisan package:discover"
        ],
        "lint": [
            "parallel-lint --exclude vendor --exclude storage --exclude modules/system/tests/fixtures/plugins/testvendor/goto/Plugin.php ."
        ],
        "sniff": [
            "phpcs --colors -nq --report=\"full\" --extensions=\"php\""
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "merge-plugin": {
            "include": [
                "plugins/rikki/*/composer.json"
            ],
            "recurse": true,
            "replace": false,
            "merge-replace": false,
            "merge-dev": false
        },
        "composer-exit-on-patch-failure": true,
        "patches": {
            "winter/storm": {
                "Remember the relation method scan for classes without relation methods (wintercms/storm#250), remove once released": "patches/winter-storm-relation-method-scan.patch"
            }
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "wikimedia/composer-merge-plugin": true,
            "cweagans/composer-patches": true
        },
        "policy": {
            "advisories": {
                "ignore": {
                    "laravel/framework": {
                        "constraint": "^9.0",
                        "reason": "Winter CMS 1.2 is built on Laravel 9 (EOL); every 9.x release has unpatched advisories. Remove once Winter supports a newer Laravel.",
                        "on-block": true,
                        "on-audit": false
                    },
                    "enshrined/svg-sanitize": {
                        "constraint": "~0.16",
                        "reason": "winter/storm 1.2.x requires enshrined/svg-sanitize ~0.16, all of which are flagged.",
                        "on-block": true,
                        "on-audit": false
                    }
                }
            }
        }
    }
}
